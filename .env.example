# Session token signing/hashing secret. REQUIRED in production.
SESSION_SECRET=change-me-session-secret

# Set to "true" ONLY when serving over HTTPS. It marks the session cookie
# Secure, so the browser sends it back only over HTTPS. Leave unset/false for
# plain-HTTP deployments (e.g. local docker-compose) — otherwise the cookie is
# never returned and you get "세션이 만료되었습니다" right after login.
SECURE_COOKIES=

# Claude Agent SDK auth — all ANTHROPIC_* vars are read by the SDK from the
# environment (docker-compose injects the whole .env, so any added later flow
# through too). Set EITHER an API key, OR a base URL + auth token for a gateway/
# proxy. When all are absent, the SDK falls back to local Claude Code auth
# (subscription login), which the container does not have.
#
# Alternatively, leave ANTHROPIC_API_KEY empty and register a Claude subscription
# token from the admin UI (관리자 ▸ 구독 로그인): paste the output of
# `claude setup-token`. It's stored AES-256-GCM-encrypted in the data volume and
# injected as CLAUDE_CODE_OAUTH_TOKEN. A non-empty ANTHROPIC_API_KEY here takes
# precedence over that stored token.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Optional. Pins the Claude model the agent runs (e.g. claude-opus-4-8).
# When absent, the Claude Agent SDK picks its default model. The admin page
# shows both this configured value and the model the SDK actually reported.
ANTHROPIC_MODEL=

# claude | local
# Default "claude": chat runs through the Claude Agent SDK (read-only).
# "local" uses a deterministic offline stub (no plugin execution) — for tests/dev.
AGENT_RUNTIME=claude

# Server + storage.
PORT=48787
APP_DATA_DIR=/app/data
# SQLite DB + uploaded avatar images live under APP_DATA_DIR.

# Read-only tool allowlist for avatar plugin execution (Write/Edit are always blocked).
READONLY_TOOLS=Read,Glob,Grep

# Default GitHub host used when a plugin or knowledge repo is entered as
# "owner/repo". Full https/git URLs are used as-is.
GITHUB_HOST=github.com

# Optional. Path to a PEM CA bundle to trust when GITHUB_HOST is a self-hosted /
# on-prem GitHub Enterprise Server with an internal corporate CA. Applied once at
# startup to BOTH TLS stacks the app uses to reach the host — the built-in fetch()
# (create_repo's REST call) AND every git clone/push (knowledge repo + plugins) —
# so you do NOT need separate NODE_EXTRA_CA_CERTS + GIT_SSL_CAINFO. It is appended
# to the system roots for fetch (public hosts keep working); for git it becomes
# libcurl's CA bundle, so include public roots in the file too if you also clone
# public-host repos. Leave empty on github.com, or when the CA is already in the
# system trust store (e.g. baked into the image via the Dockerfile CA_CERT_FILE arg).
# GITHUB_CA_CERT=/etc/ssl/certs/internal-ca.pem

# Optional. Upstream command used by the app's hex-ssh policy proxy. The Docker
# image installs the package at build time and exposes it as `hex-ssh-mcp` (the
# default), so no runtime npx download is needed. Override only for local dev
# without the global bin.
HEX_SSH_COMMAND=hex-ssh-mcp

# The FIRST user to sign up becomes the admin. There are no invite codes.
