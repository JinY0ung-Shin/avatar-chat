# Session token signing/hashing secret. REQUIRED in production.
SESSION_SECRET=change-me-session-secret

# Set to "true" ONLY when serving over HTTPS. It marks the session cookie
# Secure, so the browser sends it back only over HTTPS. Leave unset/false for
# plain-HTTP deployments (e.g. local docker-compose) — otherwise the cookie is
# never returned and you get "세션이 만료되었습니다" right after login.
SECURE_COOKIES=

# Claude Agent SDK auth — all ANTHROPIC_* vars are read by the SDK from the
# environment (docker-compose injects the whole .env, so any added later flow
# through too). Set EITHER an API key, OR a base URL + auth token for a gateway/
# proxy. When all are absent, the SDK falls back to local Claude Code auth
# (subscription login), which the container does not have.
#
# Alternatively, leave ANTHROPIC_API_KEY empty and register a Claude subscription
# token from the admin UI (관리자 ▸ 구독 로그인): paste the output of
# `claude setup-token`. It's stored AES-256-GCM-encrypted in the data volume and
# injected as CLAUDE_CODE_OAUTH_TOKEN. A non-empty ANTHROPIC_API_KEY here takes
# precedence over that stored token.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Optional. Pins the Claude model the agent runs (e.g. claude-opus-4-8).
# When absent, the Claude Agent SDK picks its default model. The admin page
# shows both this configured value and the model the SDK actually reported.
# NOTE: when set, this is a HARD lock — the per-conversation model picker in the
# chat composer is hidden and users cannot change the model.
ANTHROPIC_MODEL=

# Optional. The chat composer lets each user pick a model TIER per conversation
# (Opus / Sonnet / Haiku). These map each tier ALIAS to the concrete model id the
# SDK runs; the picker also shows the mapped id to the user. Leave a tier unset to
# let the SDK resolve that alias to the account default (the app can't name it, so
# the picker shows only the tier label). Resolution precedence:
#   ANTHROPIC_MODEL (pin, above) > user's per-conversation tier > admin override > SDK default.
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# claude | local
# Default "claude": chat runs through the Claude Agent SDK.
# "local" uses a deterministic offline stub (no plugin execution) — for tests/dev.
AGENT_RUNTIME=claude

# Server + storage.
PORT=48787
APP_DATA_DIR=/app/data
# SQLite DB + uploaded avatar images live under APP_DATA_DIR.

# Tool allowlist for read-only (unelevated colleague) chat sessions. These tools
# are always auto-approved. Owner and trusted/group-co-member sessions have access
# to a broader elevated tool set (Write/Edit/Bash, repo commit/push, SSH, etc.)
# gated by the PreToolUse hook — see the Security note in README.md.
READONLY_TOOLS=Read,Glob,Grep

# Internal/default GitHub host used when a plugin or knowledge repo is entered as
# "owner/repo". Knowledge repos must stay on this host; full github.com URLs can
# use the per-user GITHUB_TOKEN setting.
GITHUB_HOST=github.com

# Optional. Path to a PEM CA bundle to trust when GITHUB_HOST is a self-hosted /
# on-prem GitHub Enterprise Server with an internal corporate CA. Applied once at
# startup for Node fetch() and every git clone/push (knowledge repo + plugins).
# create_repo also passes this path to gh as SSL_CERT_FILE. It is appended to the
# system roots for fetch (public hosts keep working); for git it becomes libcurl's
# CA bundle, so include public roots in the file too if you also clone public-host
# repos. Leave empty on github.com, or when the CA is already in the system trust
# store (e.g. baked into the image via the Dockerfile CA_CERT_FILE arg).
# GITHUB_CA_CERT=/etc/ssl/certs/internal-ca.pem

# Optional. Upstream command used by the app's hex-ssh policy proxy. The Docker
# image installs the package at build time and exposes it as `hex-ssh-mcp` (the
# default), so no runtime npx download is needed. Override only for local dev
# without the global bin.
HEX_SSH_COMMAND=hex-ssh-mcp

# Optional. Command used to rewrite Claude SDK Bash tool calls through RTK before
# execution. If the command is not available, Bash calls run unchanged. Override
# when the rtk binary is mounted outside PATH.
RTK_COMMAND=rtk

# Optional. Deployment-wide Confluence base URL for the app-managed Confluence
# tools. On-prem Server/Data Center usually looks like:
#   https://confluence.your-company.com
# or, if Confluence is hosted under a context path:
#   https://intranet.your-company.com/confluence
# Authentication is NOT stored here: each avatar owner registers a Personal
# Access Token in Settings > 권한·연결 > 시크릿 as CONFLUENCE_PAT.
CONFLUENCE_URL=

# Optional. Override the .env file path loaded at startup (default: .env in cwd).
# Useful when running multiple instances or pointing at an environment-specific file.
# ENV_FILE=.env.production

# Optional. Pino log level: trace | debug | info | warn | error | fatal.
# Defaults to "debug" in development (NODE_ENV != production) and "info" in production.
# LOG_LEVEL=info

# Optional. Maximum number of agent turns per chat run (default: 1000).
# Lower values bound cost and latency for chatty or tool-heavy skill chains.
# MAX_TURNS=1000

# Optional. Path to the directory of built-in skills loaded for every avatar
# (default: <cwd>/default-skills). Override to point at a different skills tree
# when running outside the project root.
# DEFAULT_PLUGINS_DIR=/app/default-skills

# The FIRST user to sign up becomes the admin. There are no invite codes.
