# Required for first owner bootstrap. Change this before deployment.
OWNER_SETUP_CODE=change-me-owner-setup

# Optional. When absent, the Claude Agent SDK uses the local Claude Code
# authentication (subscription login) instead.
ANTHROPIC_API_KEY=

# auto | claude | local
# Default "claude": always run through the Claude Agent SDK (no API key required).
# Use "local" only to force the deterministic offline skill runners.
AGENT_RUNTIME=claude

# Internal service settings.
PORT=48787
SESSION_SECRET=change-me-session-secret
APP_DATA_DIR=/app/data
PUBLIC_BASE_URL=http://localhost:48787

# Marketplace source. Use either a local path mounted into the container or a git/GitHub source.
MARKETPLACE_SOURCE=/app/sample-marketplace
MARKETPLACE_REF=
GITHUB_TOKEN=

# Claude Agent SDK runtime policy.
COLLEAGUE_ALLOWED_TOOLS=Read,Glob,Grep
OWNER_PERMISSION_MODE=default
