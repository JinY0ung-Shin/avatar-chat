{
  "manifest_version": 3,
  "name": "Noah Almighty Browser Bridge",
  "version": "0.8.3",
  "description": "Lets your Noah avatar drive a tab in this browser, using the sessions you are already logged into.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "storage": {
    "managed_schema": "policy-schema.json"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://noah.corp.local/*",
      "http://localhost:5173/*",
      "http://localhost:48787/*"
    ]
  },
  "action": {
    "default_title": "Noah Browser Bridge — 클릭하면 업데이트 페이지가 열립니다"
  }
}
