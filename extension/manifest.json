{
  "manifest_version": 3,
  "name": "Noah Almighty Browser Bridge",
  "version": "0.17.0",
  "description": "Lets your Noah avatar drive a tab in this browser, using the sessions you are already logged into.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "storage": {
    "managed_schema": "policy-schema.json"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Noah Browser Bridge — 허용 사이트 설정",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://noah.corp.local/*",
      "http://localhost:5173/*",
      "http://localhost:48787/*"
    ]
  }
}
